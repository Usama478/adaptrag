ADAPTRAG_APP_NAME=AdaptRAG
ADAPTRAG_ENVIRONMENT=dev
ADAPTRAG_LOG_LEVEL=INFO
ADAPTRAG_DATA_DIR=./data
ADAPTRAG_MAX_UPLOAD_MB=20
ADAPTRAG_DATA_DIR=data
POSTGRES_USER=adaptrag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adaptrag
ADAPTRAG_DATABASE_URL=postgresql+psycopg://adaptrag:change-me@localhost:5432/adaptrag
# Embedding model (sentence-transformers name); changing it means re-embedding everything.
ADAPTRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Always cpu, so numbers are the same on the Mac and in Docker.
ADAPTRAG_EMBEDDING_DEVICE=cpu
# Prefix added to queries only (not to chunks), as the bge model card recommends.
# Quoted because it ends with a space.
ADAPTRAG_EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
# OpenAI API key for POST /documents/{id}/answer. Put the real key only in .env (gitignored),
# never here. Left empty, the answer endpoint returns 503 "not configured".
ADAPTRAG_OPENAI_API_KEY=
# Chat model for answers (note 0015). Chosen by the owner for the lowest cost.
ADAPTRAG_LLM_MODEL=gpt-4o-mini
# 0.0 = as repeatable as the API allows. Write None (ADAPTRAG_LLM_TEMPERATURE=None) for
# models that do not accept temperature; then it is not sent at all.
ADAPTRAG_LLM_TEMPERATURE=0.0
# Seconds before one LLM request gives up (the client also retries twice).
ADAPTRAG_LLM_TIMEOUT_SECONDS=30.0
# Upper limit on the length of one answer, in tokens.
ADAPTRAG_LLM_MAX_OUTPUT_TOKENS=500
# Below this top retrieval score the answer is "Not found in your documents." and the LLM
# is not called. Provisional: from 8 measured dev questions; recalibrate in Stage 4.
ADAPTRAG_RETRIEVAL_MIN_SCORE=0.55
